# Google Gemini API Key for FloraScan (read securely on the Flask backend)
# Get your free key at: https://aistudio.google.com/app/apikey
# If left empty, FloraScan seamlessly falls back to offline agronomy pathology.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: ElevenLabs Text-to-Speech configuration
VITE_ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Neon Serverless PostgreSQL Database Connection (Server-side only)
# Example: postgresql://<user>:<password>@<ep-xyz-pooler>.<region>.aws.neon.tech/<neondb>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth & JWKS configuration (Server-side validation)
JWKS_URL=https://<endpoint-id>.neonauth.<region>.aws.neon.tech/<database-name>/auth/.well-known/jwks.json
AUTH_API_URL=https://<endpoint-id>.neonauth.<region>.aws.neon.tech/<database-name>/auth
DATA_API_URL=https://<endpoint-id>.apirest.<region>.aws.neon.tech/<database-name>/rest/v1

# Public Client-side Auth Endpoint (Safe for React/Vite)
VITE_NEON_AUTH_URL=https://<endpoint-id>.neonauth.<region>.aws.neon.tech/<database-name>/auth

