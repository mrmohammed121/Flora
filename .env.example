# Google Gemini API Key for FloraScan (read securely on the Flask backend)
# Get your free key at: https://aistudio.google.com/app/apikey
# If left empty, FloraScan seamlessly falls back to offline agronomy pathology.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: ElevenLabs Text-to-Speech configuration
VITE_ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

